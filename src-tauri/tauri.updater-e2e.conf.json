{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "DISPOSABLE_TEST_UPDATER_PUBKEY_E2E_ONLY",
      "endpoints": ["http://localhost:8787/latest.json"],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
